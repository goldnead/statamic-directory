{
    "name": "goldnead/statamic-directory",
    "type": "statamic-addon",
    "description": "Site-scoped public choir directory profiles for Statamic.",
    "license": "proprietary",
    "keywords": ["statamic", "statamic-addon", "directory", "choir"],
    "authors": [{"name": "Adrian Goldner", "email": "info@adriangoldner.com"}],
    "require": {
        "php": "^8.3",
        "goldnead/statamic-teams": "^0.3",
        "statamic/cms": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\Directory\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\Directory\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.8",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Directory",
            "description": "Site-scoped public choir profiles",
            "slug": "directory"
        },
        "laravel": {
            "providers": [
                "Goldnead\\Directory\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
